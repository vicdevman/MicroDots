# Reference template. For a local production stack, prefer:
#   node scripts/generate-env.mjs --domain localhost --email admin@example.com
# The M1D installer will generate these values on a real host. If you copy this
# file manually, replace every placeholder and use `openssl rand -hex 32` for
# the two secrets below.

# Public hostname terminated by Caddy. Use a DNS name for automatic TLS,
# passkeys and web push. `localhost` uses Caddy's internal CA.
MICRODOTS_DOMAIN=dots.example.com

# Let's Encrypt account email. Required for public ACME issuance.
ACME_EMAIL=admin@example.com

# Postgres password. Generate with `openssl rand -hex 32`; hex keeps the
# DATABASE_URL safe without extra URL encoding.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Session signing secret. Must be at least 32 characters.
MICRODOTS_SESSION_SECRET=replace-with-openssl-rand-hex-32

# Optional image tag. The default local build tag is `dev`.
MICRODOTS_VERSION=dev

# Optional product defaults.
MICRODOTS_DEFAULT_MODE=balanced
MICRODOTS_TELEMETRY=off
MICRODOTS_LOG_LEVEL=info
