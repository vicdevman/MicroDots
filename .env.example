# MicroDots local development configuration.
# Copy to .env.local. Never commit real secrets.
#
# Dev values below are deliberately obvious placeholders. Generate real values
# before deploying anywhere reachable by another machine.

# Runtime
MICRODOTS_ENV=development
MICRODOTS_URL=http://localhost:5173
MICRODOTS_LOG_LEVEL=debug
MICRODOTS_TELEMETRY=off

# Database (also used by compose.dev.yaml)
POSTGRES_USER=microdots
POSTGRES_PASSWORD=microdots_dev_only
POSTGRES_DB=microdots
DATABASE_URL=postgres://microdots:microdots_dev_only@127.0.0.1:5432/microdots

# Secrets
# Development-only signing secret. Replace with 32+ random bytes for any deployment.
MICRODOTS_SESSION_SECRET=dev-only-session-secret-change-before-deploying
MICRODOTS_MASTER_KEY_FILE=/data/secrets/master.key
MICRODOTS_SETUP_TOKEN_FILE=/data/secrets/setup-token

# Paths
MICRODOTS_WORKSPACE_ROOT=/workspaces
MICRODOTS_ARTIFACT_ROOT=/data/artifacts

# Workers and policy
MICRODOTS_WORKER_CONCURRENCY=2
MICRODOTS_TASK_TIMEOUT_MS=1800000
MICRODOTS_DEFAULT_MODE=balanced

# Web push (optional in development; generate a VAPID pair for deployments)
# MICRODOTS_VAPID_PUBLIC_KEY=
# MICRODOTS_VAPID_PRIVATE_KEY=
